From f77b0489a2a3af53ff0de314de444b982b24d374 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 16:20:31 +0000
Subject: [PATCH] fix: Remotes.init() paling awal di bootstrap server

---
 .ai/CHANGELOG.md            | 3 +++
 src/server/init.server.luau | 5 ++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/.ai/CHANGELOG.md b/.ai/CHANGELOG.md
index 3d06d1d..393ba3a 100644
--- a/.ai/CHANGELOG.md
+++ b/.ai/CHANGELOG.md
@@ -1,5 +1,8 @@
 # CHANGELOG
 
+## 2026-10-10 — Bootstrap: Remotes.init() dipindah ke paling awal (belum dites di Studio)
+- init.server: Remotes.init() sebelum require service, agar kegagalan satu service tidak membuat client macet ("Folder Remotes tidak ditemukan"). Tidak memperbaiki penyebab error server; itu menunggu Output server dari user
+
 ## 2026-10-10 — Phase 6 Task 6.1: KnockService (state knock di server) (belum dites di Studio)
 - Baru: server/Services/KnockService, server/Config/KnockConfig, ADR-031. API: knock(player, reason), recover(player), isKnocked, getKnockedCount, onKnocked/onRecovered/onAllKnocked
 - Knock: state pemain NORMAL -> KNOCKED, HumanoidRootPart di-Anchor dan berbaring telentang di lantai (raycast), WalkSpeed/Jump 0, tool dilepas dan tidak bisa di-equip, respawn/reset saat knock dikembalikan ke titik knock, notifikasi lewat NoticeService
diff --git a/src/server/init.server.luau b/src/server/init.server.luau
index 9c8d75c..bd8b4f9 100644
--- a/src/server/init.server.luau
+++ b/src/server/init.server.luau
@@ -8,6 +8,10 @@ local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("GameConfi
 local Log = require(Shared:WaitForChild("Util"):WaitForChild("Log") :: ModuleScript)
 local Remotes = require(Shared:WaitForChild("Remotes") :: ModuleScript)
 
+-- Remote dibuat PERTAMA, sebelum require service. Jika satu service gagal dimuat, client tidak ikut macet
+-- menunggu folder Remotes (error "Folder Remotes tidak ditemukan"); error asli tetap muncul di Output server.
+Remotes.init()
+
 local Services = script:WaitForChild("Services")
 local GameManager = require(Services:WaitForChild("GameManager") :: ModuleScript)
 local SpawnService = require(Services:WaitForChild("SpawnService") :: ModuleScript)
@@ -27,7 +31,6 @@ local KnockConfig = require(script:WaitForChild("Config"):WaitForChild("KnockCon
 
 Log.info("Server", string.format("Malam Suro server siap (MAX_PLAYERS=%d)", GameConfig.MAX_PLAYERS))
 
-Remotes.init()
 GameManager.init()
 QuestService.init()
 ItemService.init()
-- 
2.43.0

